# ============================================
# EC-VoucherHub — Frontend Environment (Vite)
# ============================================
# Copy this file to .env and adjust if needed.
# WARNING: every VITE_* var is embedded into the public JS bundle.
# NEVER put a secret here — it would be readable by anyone in the browser.

# ---- API ----
# Used when design preview is disabled. The migrated UI still follows its
# original API adapter; alignment with the target backend /api contract is a
# separate integration task.
VITE_API_BASE_URL=http://localhost:4000/api

# Deterministic UI-only mode: no backend requests and protected routes receive
# a preview identity based on the route group (/partner or /admin).
VITE_DESIGN_PREVIEW=false
