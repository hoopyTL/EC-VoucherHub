# ============================================
# EC-VoucherHub — Backend Environment
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it is gitignored.
# In production these are injected by the host's secret manager, not a file.

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voucherhub

# Payment gateways (use sandbox/test credentials for local development)
VNP_TMNCODE=
VNP_HASHSECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment-result
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_RETURN_URL=http://localhost:5173/payment-result
PAYPAL_CANCEL_URL=http://localhost:5173/payment-result
PAYPAL_VND_PER_USD=25000
ONEPAY_MERCHANT=TESTONEPAY
ONEPAY_ACCESS_CODE=6BEB2546
ONEPAY_HASH_SECRET=6D0870CDE5F24F34F3915FB0045120DB
ONEPAY_URL=https://mtf.onepay.vn/paygate/vpcpay.op
ONEPAY_RETURN_URL=http://localhost:5173/payment-result

# ---- JWT ----
# In production JWT_SECRET must be long + random (not this placeholder) — config validation enforces it.
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

# ---- Server ----
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
