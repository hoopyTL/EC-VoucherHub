generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS

enum UserStatus {
  ACTIVE @map("active")
  LOCKED @map("locked")

  @@map("user_status")
}

enum ApprovalStatus {
  PENDING  @map("pending")
  APPROVED @map("approved")
  REJECTED @map("rejected")

  @@map("approval_status")
}

enum OperatingStatus {
  ACTIVE    @map("active")
  SUSPENDED @map("suspended")

  @@map("operating_status")
}

enum VoucherStatus {
  DRAFT          @map("draft")
  PENDING_REVIEW @map("pending_review")
  APPROVED       @map("approved")
  REJECTED       @map("rejected")
  ON_SALE        @map("on_sale")
  PAUSED         @map("paused")
  DISCONTINUED   @map("discontinued")

  @@map("voucher_status")
}

enum OrderStatus {
  PENDING_PAYMENT @map("pending_payment")
  PAID            @map("paid")
  CANCELLED       @map("cancelled")
  REFUNDED        @map("refunded")

  @@map("order_status")
}

enum VoucherCodeStatus {
  UNUSED    @map("unused")
  USED      @map("used")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")
  LOCKED    @map("locked")

  @@map("voucher_code_status")
}

enum UsageResult {
  SUCCESS      @map("success")
  INVALID_CODE @map("invalid_code")
  EXPIRED      @map("expired")
  ALREADY_USED @map("already_used")
  WRONG_BRANCH @map("wrong_branch")
  LOCKED       @map("locked")

  @@map("usage_result")
}

enum PaymentStatus {
  PENDING  @map("pending")
  SUCCESS  @map("success")
  FAILED   @map("failed")
  REFUNDED @map("refunded")

  @@map("payment_status")
}

enum StaffStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")

  @@map("staff_status")
}

// MODELS — Tài khoản & vai trò

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique @db.VarChar(32)

  // Relations
  users User[]

  @@map("roles")
}

/// Bảng đăng nhập chung cho mọi vai trò. CHECK tay: email IS NOT NULL OR phone IS NOT NULL.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String?    @unique @db.VarChar(255)
  phone        String?    @unique @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  tokenVersion Int        @default(0) @map("token_version")
  roleId       Int        @map("role_id")
  status       UserStatus @default(ACTIVE)
  fullName     String     @map("full_name") @db.VarChar(255)
  address      String?    @db.Text
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  role               Role                @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partner            Partner?
  staffProfile       PartnerStaff?
  cart               Cart?
  orders             Order[]
  issuedVoucherCodes IssuedVoucherCode[]
  usageLogs          UsageLog[]
  contentItems       ContentItem[]
  auditLogs          AuditLog[]
  reviews            Review[]

  @@map("users")
}

// MODELS — Đối tác

/// Hồ sơ doanh nghiệp đối tác. ownerUserId @unique → quan hệ 1:0..1 với User (quyết định 2026-06-16).
model Partner {
  id              String          @id @default(uuid()) @db.Uuid
  ownerUserId     String          @unique @map("owner_user_id") @db.Uuid
  legalName       String          @map("legal_name") @db.VarChar(255)
  taxCode         String          @unique @map("tax_code") @db.VarChar(32)
  representative  String          @db.VarChar(255)
  businessCategory String?        @map("business_category") @db.VarChar(128)
  logoUrl          String?        @map("logo_url") @db.VarChar(1024)
  approvalStatus  ApprovalStatus  @default(PENDING) @map("approval_status")
  rejectReason    String?         @map("reject_reason") @db.Text
  operatingStatus OperatingStatus @default(ACTIVE) @map("operating_status")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  owner           User             @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branches        Branch[]
  voucherProducts VoucherProduct[]
  staff           PartnerStaff[]

  @@map("partners")
}

/// Chi nhánh đối tác. Đợt 2 — đã khai schema sẵn, feature (redeem + lọc khu vực) làm sau.
model Branch {
  id        Int    @id @default(autoincrement())
  partnerId String @map("partner_id") @db.Uuid
  name      String @db.VarChar(255)
  address   String @db.Text
  region    String @db.VarChar(128)

  // Relations
  partner                Partner                @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voucherProductBranches VoucherProductBranch[]
  usageLogs              UsageLog[]
  staffAssignments       PartnerStaffBranch[]

  @@index([partnerId])
  @@index([region])
  @@map("branches")
}

model PartnerStaff {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @unique @map("user_id") @db.Uuid
  partnerId String      @map("partner_id") @db.Uuid
  status    StaffStatus @default(ACTIVE)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  partner     Partner              @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignments PartnerStaffBranch[]

  @@index([partnerId])
  @@index([status])
  @@map("partner_staff")
}

model PartnerStaffBranch {
  staffId   String   @map("staff_id") @db.Uuid
  branchId  Int      @map("branch_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  staff  PartnerStaff @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([staffId, branchId])
  @@index([branchId])
  @@map("partner_staff_branches")
}

// MODELS — Danh mục & voucher

/// Danh mục cây (self-reference). Seeded cố định — không có màn admin quản lý danh mục ở MVP.
model Category {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(128)
  parentId Int?   @map("parent_id")

  // Relations (self-reference cần named relation)
  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children        Category[]       @relation("CategoryTree")
  voucherProducts VoucherProduct[]

  @@unique([name, parentId])
  @@map("categories")
}

/// Sản phẩm voucher. 7 trạng thái (máy trạng thái chính — xem docs/02-srs §1.4).
/// CHECK tay: sale_price < original_price, remaining_quantity <= total_quantity,
///   total_quantity >= 0, remaining_quantity >= 0,
///   uses_per_code IS NULL OR uses_per_code > 0,
///   is_multi_use = false OR uses_per_code IS NOT NULL.
model VoucherProduct {
  id                String        @id @default(uuid()) @db.Uuid
  partnerId         String        @map("partner_id") @db.Uuid
  categoryId        Int?          @map("category_id")
  name              String        @db.VarChar(255)
  description       String        @db.Text
  imageUrl          String?       @map("image_url") @db.VarChar(512)
  originalPrice     Decimal       @map("original_price") @db.Decimal(12, 2)
  salePrice         Decimal       @map("sale_price") @db.Decimal(12, 2)
  saleStart         DateTime      @map("sale_start") @db.Timestamptz(6)
  saleEnd           DateTime      @map("sale_end") @db.Timestamptz(6)
  usageStart        DateTime      @map("usage_start") @db.Timestamptz(6)
  usageEnd          DateTime      @map("usage_end") @db.Timestamptz(6)
  totalQuantity     Int           @map("total_quantity")
  remainingQuantity Int           @map("remaining_quantity")
  isMultiUse        Boolean       @default(false) @map("is_multi_use")
  usesPerCode       Int?          @map("uses_per_code")
  status            VoucherStatus @default(DRAFT)
  rejectReason      String?       @map("reject_reason") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  partner                Partner                @relation(fields: [partnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  category               Category?              @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voucherProductBranches VoucherProductBranch[]
  cartItems              CartItem[]
  orderItems             OrderItem[]
  issuedVoucherCodes     IssuedVoucherCode[]
  reviews                Review[]

  @@index([partnerId])
  @@index([categoryId])
  @@index([status])
  @@index([saleStart, saleEnd])
  @@index([usageStart, usageEnd])
  @@index([remainingQuantity])
  @@map("voucher_products")
}

/// Khuyến mãi tham chiếu từ nguồn công khai. Tách khỏi VoucherProduct vì
/// VoucherHub không sở hữu tồn kho/mã và không được phép checkout/redeem.
model ExternalPromotion {
  id                 String   @id @default(uuid()) @db.Uuid
  source             String   @db.VarChar(32)
  externalId         String   @map("external_id") @db.VarChar(128)
  sourceUrl          String   @map("source_url") @db.VarChar(1024)
  name               String   @db.VarChar(512)
  description        String?  @db.Text
  merchant           String?  @db.VarChar(255)
  category           String?  @db.VarChar(128)
  imageUrl           String?  @map("image_url") @db.VarChar(1024)
  originalPrice      Decimal? @map("original_price") @db.Decimal(12, 2)
  salePrice          Decimal? @map("sale_price") @db.Decimal(12, 2)
  discountPercentage Int?     @map("discount_percentage")
  promoCode          String?  @map("promo_code") @db.VarChar(128)
  terms              String?  @db.Text
  saleStart          DateTime? @map("sale_start") @db.Timestamptz(6)
  saleEnd            DateTime? @map("sale_end") @db.Timestamptz(6)
  firstSeenAt        DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt         DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([source, externalId])
  @@index([source])
  @@index([lastSeenAt])
  @@map("external_promotions")
}

/// Bảng nối N-M: voucher áp dụng tại chi nhánh nào. Đợt 2 — schema sẵn.
model VoucherProductBranch {
  voucherProductId String @map("voucher_product_id") @db.Uuid
  branchId         Int    @map("branch_id")

  // Relations
  voucherProduct VoucherProduct @relation(fields: [voucherProductId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([voucherProductId, branchId])
  @@index([branchId])
  @@map("voucher_product_branches")
}

// MODELS — Giỏ hàng

/// Giỏ hàng server-side. 1 khách ↔ 1 giỏ (customerId @unique).
/// Tổng tạm tính KHÔNG lưu — tính realtime từ voucher_products.sale_price.
model Cart {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @unique @map("customer_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer  User       @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  cartItems CartItem[]

  @@map("carts")
}

/// Dòng trong giỏ. CHECK tay: quantity > 0.
/// UNIQUE(cartId, voucherProductId) — 1 voucher = 1 dòng, thêm lại → cộng dồn quantity.
model CartItem {
  id               Int      @id @default(autoincrement())
  cartId           String   @map("cart_id") @db.Uuid
  voucherProductId String   @map("voucher_product_id") @db.Uuid
  quantity         Int
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  voucherProduct VoucherProduct @relation(fields: [voucherProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cartId, voucherProductId])
  @@index([voucherProductId])
  @@map("cart_items")
}

// MODELS — Đơn hàng

/// Đơn hàng. 4 trạng thái (máy trạng thái — xem docs/02-srs §1.4).
model Order {
  id            String      @id @default(uuid()) @db.Uuid
  customerId    String      @map("customer_id") @db.Uuid
  /// denormalized snapshot — cố ý: đông cứng tổng tiền = Σ(unit_price × quantity) lúc đặt.
  totalAmount   Decimal     @map("total_amount") @db.Decimal(12, 2)
  paymentMethod String      @map("payment_method") @db.VarChar(32)
  status        OrderStatus @default(PENDING_PAYMENT)
  giftRecipient Json?       @map("gift_recipient") @db.JsonB
  paidAt        DateTime?   @map("paid_at") @db.Timestamptz(6)
  expiresAt     DateTime?   @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer            User                 @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems          OrderItem[]
  issuedVoucherCodes  IssuedVoucherCode[]
  paymentTransactions PaymentTransaction[]
  reviews             Review[]

  @@index([customerId])
  @@index([status])
  @@map("orders")
}

/// Dòng đơn hàng (bất biến sau khi tạo — không cần updatedAt).
/// unit_price = snapshot giá bán lúc đặt, không đổi kể cả khi voucher đổi giá sau.
/// CHECK tay: quantity > 0.
model OrderItem {
  id               Int     @id @default(autoincrement())
  orderId          String  @map("order_id") @db.Uuid
  voucherProductId String  @map("voucher_product_id") @db.Uuid
  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2)

  // Relations
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voucherProduct     VoucherProduct      @relation(fields: [voucherProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  issuedVoucherCodes IssuedVoucherCode[]

  @@index([orderId])
  @@index([voucherProductId])
  @@map("order_items")
}

/// Lịch sử giao dịch thanh toán. Mỗi đơn hàng có thể có nhiều lần thử thanh toán.
/// Lưu trữ thông tin từ cổng thanh toán (VNPay, Stripe) để đối soát và tra cứu.
model PaymentTransaction {
  id             String        @id @default(uuid()) @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  /// Cổng thanh toán: VNPAY, STRIPE, SIMULATE...
  gateway        String        @db.VarChar(32)
  /// Mã giao dịch phía cổng thanh toán (vnp_TransactionNo, Stripe checkout session id...)
  gatewayTransId String?       @map("gateway_trans_id") @db.VarChar(255)
  /// Số tiền thực tế gửi lên cổng (đơn vị VND hoặc cents tuỳ gateway)
  amount         Decimal       @db.Decimal(12, 2)
  /// Mã tiền tệ: VND, USD...
  currency       String        @default("VND") @db.VarChar(8)
  status         PaymentStatus @default(PENDING)
  /// Raw response / metadata từ cổng thanh toán (để đối soát)
  rawResponse    Json?         @map("raw_response") @db.JsonB
  /// Lý do thất bại (nếu có)
  failureReason  String?       @map("failure_reason") @db.Text
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  refundedAt     DateTime?     @map("refunded_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([gateway])
  @@index([status])
  @@index([gatewayTransId])
  @@map("payment_transactions")
}

// MODELS — Phát hành & sử dụng

/// Mã voucher đã phát hành. 5 trạng thái (máy trạng thái — xem docs/02-srs §1.4).
/// code ≥ 12 ký tự, sinh bằng CSPRNG (FR-08 AC3/4).
model IssuedVoucherCode {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique @db.VarChar(32)
  /// denormalized — cố ý: tiện truy ngược mã → đơn mà không join 2 chặng qua order_items.
  orderId          String            @map("order_id") @db.Uuid
  orderItemId      Int               @map("order_item_id")
  voucherProductId String            @map("voucher_product_id") @db.Uuid
  ownerUserId      String            @map("owner_user_id") @db.Uuid
  status           VoucherCodeStatus @default(UNUSED)
  remainingUses    Int               @default(1) @map("remaining_uses")
  issuedAt         DateTime          @default(now()) @map("issued_at") @db.Timestamptz(6)
  /// denormalized snapshot — cố ý: đông cứng hạn sử dụng từ voucher_products.usage_end lúc phát hành.
  expiresAt        DateTime          @map("expires_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItem      OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  voucherProduct VoucherProduct @relation(fields: [voucherProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  owner          User           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usageLogs      UsageLog[]

  @@index([orderId])
  @@index([orderItemId])
  @@index([voucherProductId])
  @@index([ownerUserId])
  @@index([status])
  @@map("issued_voucher_codes")
}

/// Nhật ký sử dụng/redeem (bất biến — không cần updatedAt). Đợt 2 — schema sẵn.
model UsageLog {
  id           Int         @id @default(autoincrement())
  issuedCodeId String      @map("issued_code_id") @db.Uuid
  branchId     Int         @map("branch_id")
  actorUserId  String      @map("actor_user_id") @db.Uuid
  usedAt       DateTime    @default(now()) @map("used_at") @db.Timestamptz(6)
  result       UsageResult

  // Relations
  issuedCode IssuedVoucherCode @relation(fields: [issuedCodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actor      User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([issuedCodeId])
  @@index([branchId])
  @@index([actorUserId])
  @@map("usage_logs")
}

/// Nội dung vận hành do admin quản lý: banner, thông báo, chính sách demo.
model ContentItem {
  id           String    @id @default(uuid()) @db.Uuid
  type         String    @db.VarChar(32)
  title        String    @db.VarChar(255)
  body         String    @db.Text
  status       String    @default("draft") @db.VarChar(32)
  displayFrom  DateTime? @map("display_from") @db.Timestamptz(6)
  displayTo    DateTime? @map("display_to") @db.Timestamptz(6)
  authorUserId String    @map("author_user_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  author User @relation(fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([type])
  @@index([status])
  @@index([authorUserId])
  @@map("content_items")
}

/// Nhật ký kiểm toán thao tác quản trị quan trọng.
model AuditLog {
  id          Int      @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(64)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(128)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relations
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}

// MODELS — Review & Rating
model Review {
  id               String         @id @default(uuid()) @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  voucherProductId String         @map("voucher_product_id") @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  rating           Int            // 1–5
  comment          String?        @db.Text
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  customer       User           @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  voucherProduct VoucherProduct @relation(fields: [voucherProductId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([customerId, voucherProductId]) // 1 review duy nhất per customer per voucher
  @@index([voucherProductId])
  @@index([customerId])
  @@map("reviews")
}
